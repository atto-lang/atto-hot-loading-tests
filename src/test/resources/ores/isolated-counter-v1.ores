// Isolated actor v1: each invocation must start from its own owned state.
define isoactor Counter as
  let int count;

  on_start(): void {
    self.count = 0;
    return;
  }

  receive(ActorMail<String> mail): void {
    self.count = self.count + 1;
    self.send(self.count);
    self.end();
    return;
  }
end

pub async routine main(): void {
  val worker = spawn Counter();
  await worker.get_ready();
  worker.send("tick");
  val output = (await worker.outputs.next()).value.unwrap();
  if output.value != 1; do
    val numbers = arr[1];
    val invalid = numbers[99];
  fi
  await worker.get_done();
  return;
}
